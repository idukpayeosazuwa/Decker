rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (as mandated)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives and Guards
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Mandated verification check
    function isVerifiedUser() {
      return isSignedIn();
    }

    // Entity shape schemas
    function isValidCourse(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'color', 'createdAt'])
        && (data.keys().size() == 5 || (data.keys().size() == 6 && data.keys().hasAll(['notesCount'])))
        && isValidId(data.id)
        && data.code is string && data.code.size() <= 20
        && data.name is string && data.name.size() <= 100
        && data.color is string && data.color.size() <= 50
        && (data.createdAt is string || data.createdAt == request.time)
        && (!data.keys().hasAll(['notesCount']) || (data.notesCount is int && data.notesCount >= 0));
    }

    function isValidNote(data, pathCourseId) {
      return data.keys().hasAll(['id', 'courseId', 'title', 'order', 'images', 'ocrStatus', 'createdAt'])
        && (data.keys().size() >= 7 && data.keys().size() <= 10)
        && isValidId(data.id)
        && data.courseId == pathCourseId
        && data.title is string && data.title.size() <= 100
        && data.order is int && data.order >= 1
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 50
        && data.images[0] is string
        && data.ocrStatus is string && (data.ocrStatus == 'idle' || data.ocrStatus == 'processing' || data.ocrStatus == 'completed' || data.ocrStatus == 'failed')
        && (data.createdAt is string || data.createdAt == request.time)
        && (!data.keys().hasAll(['description']) || (data.description is string && data.description.size() <= 1000));
    }

    // Courses matching routes
    match /courses/{courseId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isVerifiedUser() 
        && isValidId(courseId) 
        && isValidCourse(incoming())
        && incoming().id == courseId;

      allow update: if isVerifiedUser()
        && isValidId(courseId)
        && isValidCourse(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'color', 'notesCount']);

      allow delete: if isVerifiedUser()
        && isValidId(courseId);

      // Subcollection for sequential visual Notes
      match /notes/{noteId} {
        allow get: if true;
        allow list: if true;

        allow create: if isVerifiedUser()
          && isValidId(noteId)
          && isValidNote(incoming(), courseId)
          && incoming().id == noteId;

        allow update: if isVerifiedUser()
          && isValidId(noteId)
          && isValidNote(incoming(), courseId)
          && incoming().id == existing().id
          && incoming().courseId == existing().courseId
          && incoming().createdAt == existing().createdAt
          && (
            // Action 1: OCR update
            incoming().diff(existing()).affectedKeys().hasOnly(['ocrStatus', 'ocrText']) ||
            // Action 2: Metadata edit
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'order', 'description', 'images']) ||
            // Action 3: Combined upload save
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'order', 'description', 'images', 'ocrStatus', 'ocrText'])
          );

        allow delete: if isVerifiedUser()
          && isValidId(noteId);
        }
    }
  }
}
