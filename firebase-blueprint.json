{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Represents a course binder or module in Decker",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the course"
        },
        "code": {
          "type": "string",
          "description": "Course code (e.g. CSC301)"
        },
        "name": {
          "type": "string",
          "description": "Descriptive course name"
        },
        "color": {
          "type": "string",
          "description": "Color theme indicator for course cover"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "code", "name", "color", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A single sequential slide or lecture note attached to a course",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the note"
        },
        "courseId": {
          "type": "string",
          "description": "Associated course booklet ID"
        },
        "title": {
          "type": "string",
          "description": "Title of the note slide"
        },
        "order": {
          "type": "integer",
          "description": "Chronological/sequential index"
        },
        "images": {
          "type": "array",
          "description": "Base64 data URIs or image storage URLs"
        },
        "ocrText": {
          "type": "string",
          "description": "Extracted OCR text payload"
        },
        "ocrStatus": {
          "type": "string",
          "enum": ["idle", "processing", "completed", "failed"],
          "description": "Text extraction status for index searchability"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp"
        },
        "description": {
          "type": "string",
          "description": "Optional slide notes description"
        }
      },
      "required": ["id", "courseId", "title", "order", "images", "ocrStatus", "createdAt"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Root collection for course binders"
    },
    "/courses/{courseId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Subcollection storing course chronological visual slides"
    }
  }
}
